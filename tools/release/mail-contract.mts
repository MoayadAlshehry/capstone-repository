import{parseAccountMailConfig,ZOHO_EMAIL_ENDPOINTS,APPROVED_ZEPTOMAIL_US_ENDPOINT}from'../../packages/config/src/account-mail.js';
import{randomBytes}from'node:crypto';import assert from'node:assert/strict';import{writeFile,mkdir}from'node:fs/promises';
const common={ACCOUNT_MAIL_ENCRYPTION_KEY:randomBytes(32).toString('base64url'),ACCOUNT_MAIL_KEY_ID:'v1',ACCOUNT_MAIL_FROM_ADDRESS:'test@example.invalid',ACCOUNT_MAIL_APP_ORIGIN:'https://app.example.invalid',ACCOUNT_MAIL_AGENT_KEY:'synthetic-test-configuration-key-only'};
const results=[];
for(const [region,endpoint]of [...Object.entries(ZOHO_EMAIL_ENDPOINTS),['US',APPROVED_ZEPTOMAIL_US_ENDPOINT]]){const cfg=parseAccountMailConfig({...common,ACCOUNT_MAIL_MODE:'zoho',ACCOUNT_MAIL_REGION:region,ACCOUNT_MAIL_ENDPOINT:endpoint},process.cwd(),'local');assert.equal(cfg.endpoint,endpoint);results.push({test:'source-approved-provider-'+region+(endpoint===APPROVED_ZEPTOMAIL_US_ENDPOINT?'-legacy':''),passed:true,network_send:false});}
for(const override of [{ACCOUNT_MAIL_ENDPOINT:'https://example.invalid/send'},{ACCOUNT_MAIL_APP_ORIGIN:'http://127.0.0.1:3760'},{ACCOUNT_MAIL_AGENT_KEY:'synthetic bad key with whitespace'},{ACCOUNT_MAIL_FROM_ADDRESS:'test@capstone.local'}]){assert.throws(()=>parseAccountMailConfig({...common,ACCOUNT_MAIL_MODE:'zoho',ACCOUNT_MAIL_REGION:'US',ACCOUNT_MAIL_ENDPOINT:APPROVED_ZEPTOMAIL_US_ENDPOINT,...override},process.cwd(),'local'));results.push({test:'invalid-source-provider-config-refused',passed:true,network_send:false});}
assert.equal(parseAccountMailConfig({...common,ACCOUNT_MAIL_MODE:'capture',ACCOUNT_MAIL_APP_ORIGIN:'http://127.0.0.1:3760',ACCOUNT_MAIL_CAPTURE_ROOT:process.cwd()+'/.local/mail'},process.cwd(),'local').mode,'capture');results.push({test:'source-local-capture-contract',passed:true,network_send:false});
await mkdir('.local',{recursive:true,mode:0o700});await writeFile('.local/mail-contract-proof.json',JSON.stringify({results,actual_external_delivery:'NOT_RUN_NO_AUTHORIZED_PROVIDER_TEST_CREDENTIALS',production_credentials_used:false},null,2),{mode:0o600});console.log('SOURCE_MAIL_PROVIDER_AND_CAPTURE_CONTRACTS_PASS | '+results.length+' checks; no external sends');
