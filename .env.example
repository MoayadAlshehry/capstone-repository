CAPSTONE_AI_BASE_URL=http://127.0.0.1:1234
CAPSTONE_AI_WINDOWS_MEMORY_CHECK=true
# Set by the installer after optional existing synthetic Demo loading.
CAPSTONE_SYNTHETIC_DEMO=false
ACCOUNT_MAIL_MODE=capture
COMMITTEE_MAIL_MODE=mailpit
