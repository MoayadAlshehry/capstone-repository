import{readFile,lstat}from'node:fs/promises';import{resolve}from'node:path';import{createHash}from'node:crypto';import{ownedInstallation,database,emptyStorage}from'./ownership.js';import{privateRoot,safePath,sourceRoot}from'./store.js';import{factoryVersion}from'./scenarios.js';
const o=await ownedInstallation();const journal=resolve(privateRoot,'journal.json');await safePath(journal);
if(!await emptyStorage(o.runtime.PRIVATE_STORAGE_ROOT)){try{await readFile(journal);}catch(e){if((e as NodeJS.ErrnoException).code==='ENOENT')throw Error('DEMO_REQUIRES_EMPTY_OWNED_STORAGE');throw e;}}
try{const s=await lstat(journal);if(!s.isFile()||s.mode&0o077||s.uid!==process.getuid?.())throw Error('DEMO_PRIVATE_JOURNAL_REQUIRED');const j=JSON.parse(await readFile(journal,'utf8'));const hash=createHash('sha256').update(await readFile(resolve(sourceRoot,'demo/ASSET_MANIFEST.json'))).digest('hex');if(j.owner!==o.state.owner||j.version!==factoryVersion||j.assetManifest!==hash)throw Error('DEMO_FOREIGN_JOURNAL');console.log('OWNED_DEMO_JOURNAL_PRESENT');}
catch(e){if((e as NodeJS.ErrnoException).code!=='ENOENT')throw e;await database(o.migration,async c=>{const r=(await c.query("SELECT (SELECT count(*) FROM app.users)::int users,(SELECT count(*) FROM app.users WHERE email=$1 AND role_code='platform_admin')::int initial_admin,(SELECT count(*) FROM app.projects)::int projects,(SELECT count(*) FROM app.universities)::int universities,(SELECT count(*) FROM app.storage_objects)::int originals",[o.state.admin_email])).rows[0];if(r.users!==1||r.initial_admin!==1||r.projects||r.universities||r.originals)throw Error('DEMO_REQUIRES_NEW_BLANK_INSTALL_EXISTING_USER_DATA_RETAINED');});console.log('NEW_BLANK_OWNED_DEMO_TARGET_VERIFIED');}
