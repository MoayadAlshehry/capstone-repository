import {installedAccountSetupToken} from '../tools/testing/installed-account-setup.js';
import{readFile,writeFile,readdir}from'node:fs/promises';import{createRequire}from'node:module';import{randomUUID,randomBytes}from'node:crypto';
import{createAuthentication}from'@capstone/db/auth';import{createOnboarding}from'@capstone/db/onboarding';import{createAccountMail}from'@capstone/db/account-mail';import{decryptAccountMail}from'@capstone/db/account-mail-crypto';
const root=process.cwd(),e=JSON.parse(await readFile('.local/runtime.json','utf8')),state=JSON.parse(await readFile('.local/installation.json','utf8')),admin=JSON.parse(await readFile('.local/accounts/bootstrap-admin.json','utf8')),cfg=JSON.parse(await readFile('.local/database/config.json','utf8')),base=e.AUTH_BASE_URL;
const login=async(email:string,password:string)=>{const r=await fetch(base+'/api/auth/sign-in/email',{method:'POST',headers:{Origin:base,'Content-Type':'application/json'},body:JSON.stringify({email,password})});if(r.status!==200)throw Error('LOGIN_REQUIRED');return r.headers.getSetCookie().map(x=>x.split(';')[0]).join('; ');};
const auth=createAuthentication({databaseUrl:e.DATABASE_URL,secret:e.AUTH_SECRET,baseURL:base,environment:'local'}),mail=createAccountMail(e.DATABASE_URL,{mode:'capture',appOrigin:base,key:e.ACCOUNT_MAIL_ENCRYPTION_KEY,keyId:'v1'}),on=createOnboarding(e.DATABASE_URL,mail);
const platformCookie=await login(admin.email,admin.password),platform=await auth.account(new Headers({Cookie:platformCookie}));if(!platform)throw Error('PLATFORM_SESSION_REQUIRED');
const {Client}=createRequire(root+'/packages/db/package.json')('pg');const db=new Client({connectionString:`postgresql://capstone_migrator:${cfg.passwords.migration}@127.0.0.1:${cfg.developmentPort}/capstone_local`});await db.connect();
try{
 const uni=(await db.query("SELECT id FROM app.universities WHERE code='KIT_FOREIGN_QA'")).rows[0]??await on.command(platform,randomUUID(),'university.create',{code:'KIT_FOREIGN_QA',name_en:'Example unrelated institution',name_ar:'جامعة اختبار مستقلة'});
 const email='unrelated.admin@capstone.local';
 let invited=(await db.query('SELECT id FROM app.users WHERE email=$1',[email])).rows[0];if(!invited){const response=await fetch(base+'/api/onboarding',{method:'POST',headers:{Origin:base,Cookie:platformCookie,'Content-Type':'application/json'},body:JSON.stringify({command:randomUUID(),operation:'administrator.invite',payload:{university:uni.id,name:'Example unrelated administrator',email,locale:'en'}})});if(response.status!==200)throw Error('ACTUAL_ADMIN_INVITATION_FAILED');invited=await response.json();}
 let captures:string[]=[];for(let i=0;i<100;i++){try{captures=await readdir('.local/mail');if(captures.length)break;}catch{}await new Promise(r=>setTimeout(r,100));}if(!captures.length)throw Error('LOCAL_ACCOUNT_CAPTURE_NOT_OBSERVED');
 const row=(await db.query("SELECT * FROM app.account_email_outbox WHERE user_id=$1 AND purpose='ACCOUNT_SETUP' ORDER BY created_at DESC LIMIT 1",[invited.id])).rows[0];
 const token=await installedAccountSetupToken({id:row.id,ciphertext:null},'',invited.id,base,process.cwd()+'/.local/mail'),password=randomBytes(24).toString('base64url');if(!(await mail.complete(token,'ACCOUNT_SETUP',password,'stage6-foreign')).completed)throw Error('MANAGED_SETUP_FAILED');
 const cookie=await login(email,password),record=JSON.parse(await readFile('.local/qa-private-record.json','utf8'));const denied=await fetch(base+record.path,{headers:{Cookie:cookie}});if(denied.status!==404)throw Error('FOREIGN_TENANT_FILE_EXPOSURE');
 await writeFile('.local/mail-and-foreign-results.json',JSON.stringify({account_invitation_http:200,local_capture_files:captures.length,managed_setup:true,foreign_admin_login:200,foreign_original:denied.status,expected:404,real_external_mail:false,committee_mode:e.COMMITTEE_MAIL_MODE},null,2));console.log('REAL_LOCAL_ACCOUNT_CAPTURE_AND_FOREIGN_TENANT_DENIAL_PASS');
}finally{await db.end();await on.close();await mail.close();await auth.close();}
